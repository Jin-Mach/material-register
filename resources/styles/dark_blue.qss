QWidget {
    background-color: #2b2d30;
    color: #d4d4d4;
    font-size: 13px;
}

QLabel {
    background-color: #2b2d30;
    color: #d4d4d4;
}

QLineEdit,
QTextEdit,
QComboBox,
QDateEdit,
QDoubleSpinBox,
QSpinBox {
    background-color: #232528;
    border: 1px solid #45484d;
    border-radius: 4px;
    color: #d4d4d4;
}

QLineEdit,
QComboBox,
QDateEdit,
QDoubleSpinBox,
QSpinBox {
    padding: 4px 6px;
}

QLineEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QDoubleSpinBox:focus,
QSpinBox:focus {
    border-color: #4b8cc9;
}

QLineEdit:disabled,
QTextEdit:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QDoubleSpinBox:disabled,
QSpinBox:disabled {
    background-color: #1f2022;
    color: #777a80;
}

QComboBox {
    min-width: 120px;
    selection-background-color: #3d6f9f;
    selection-color: #ffffff;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    min-width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #c8c9cc;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #232528;
    border: 1px solid #45484d;
    color: #d4d4d4;
    min-width: 200px;
    padding: 4px 6px;
    selection-background-color: #3d6f9f;
    selection-color: #ffffff;
    show-decoration-selected: 1;
    qproperty-textElideMode: ElideNone;
}

QComboBox QAbstractItemView::item {
    border: none;
    padding: 4px 6px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #3d6f9f;
    color: #ffffff;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #45484d;
    color: #ffffff;
}

QDateEdit {
    padding: 4px 6px;
    color: #d4d4d4;
    selection-background-color: #3d6f9f;
    selection-color: #ffffff;
}

QCalendarWidget {
    background-color: #2b2d30;
    color: #d4d4d4;
}

QCalendarWidget QMenu {
    background-color: #232528;
    color: #d4d4d4;
}

QCalendarWidget QMenu::item {
    background-color: transparent;
    color: #d4d4d4;
}

QCalendarWidget QMenu::item:selected {
    background-color: #3d6f9f;
    color: #ffffff;
}

QCalendarWidget QTableView {
    background-color: #232528;
    color: #d4d4d4;
    gridline-color: #3b3e42;
    selection-background-color: #3d6f9f;
    selection-color: #ffffff;
    show-decoration-selected: 1;
    alternate-background-color: #2b2d30;
}

QCalendarWidget QTableView::item {
    padding: 4px;
    border: none;
}

QCalendarWidget QTableView::item:selected {
    background-color: #3d6f9f;
    color: #ffffff;
}

QCalendarWidget QTableView::item:hover {
    background-color: #4a4d52;
    color: #ffffff;
}

#qt_calendar_navigationbar {
    background-color: #232528;
}

#qt_calendar_navigationbar QPushButton {
    background-color: #3a3d41;
    color: #d4d4d4;
    border: 1px solid #4a4d52;
    border-radius: 4px;
    padding: 4px 8px;
}

#qt_calendar_navigationbar QPushButton:hover {
    background-color: #45484d;
    border-color: #5a5e64;
}

QPushButton {
    background-color: #3a3d41;
    color: #d4d4d4;
    border: 1px solid #4a4d52;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 70px;
}

QPushButton:hover {
    background-color: #45484d;
    border-color: #4386bd;
}

QPushButton:pressed {
    background-color: #303236;
    border-color: #4b8cc9;
}

QPushButton:disabled {
    background-color: #303236;
    color: #777a80;
    border-color: #3b3e42;
}

QRadioButton,
QCheckBox {
    background-color: #232528;
    color: #d4d4d4;
    spacing: 6px;
}

QRadioButton::indicator,
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #4a4d52;
    border-radius: 8px;
    background-color: #232528;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator:checked,
QCheckBox::indicator:checked {
    background-color: #4b8cc9;
    border-color: #4b8cc9;
}

QRadioButton::indicator:hover,
QCheckBox::indicator:hover {
    border-color: #5a9bd5;
}

QRadioButton::indicator:disabled,
QCheckBox::indicator:disabled {
    background-color: #1f2022;
    border-color: #3b3e42;
}

QRadioButton::indicator:checked:disabled,
QCheckBox::indicator:checked:disabled {
    background-color: #4b8cc9;
    border-color: #4b8cc9;
}

QTableView,
QTreeView,
QListWidget {
    background-color: #232528;
    border: 1px solid #45484d;
    border-radius: 4px;
    gridline-color: #3b3e42;
    alternate-background-color: #2b2d30;
    selection-background-color: #3d6f9f;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #232528;
    border: none;
    border-bottom: 1px solid #45484d;
    padding: 5px 7px;
    color: #cfd1d4;
    font-weight: bold;
}

QTableView::item,
QTreeView::item,
QListWidget::item {
    padding: 3px 4px;
}

QTreeView::item:hover,
QTreeWidget::item:hover {
    background-color: #4a4d52;
    color: #ffffff;
}

QTabWidget {
    background-color: #2b2d30;
}

QTabWidget::pane {
    background-color: #2b2d30;
    border: 1px solid #45484d;
    border-radius: 4px;
    padding: 6px;
    margin-top: -1px;
}

QTabWidget::tab-bar {
    alignment: center;
    background-color: #2b2d30;
}

QTabBar {
    background-color: #2b2d30;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #232528;
    border: 1px solid #45484d;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #85888d;
    margin-right: 2px;
    padding: 6px 12px;
    min-width: 80px;
    max-width: 160px;
    min-height: 24px;
}

QTabBar::tab:hover {
    background-color: #3a3d41;
    color: #d4d4d4;
}

QTabBar::tab:selected {
    background-color: #3d6f9f;
    border: 1px solid #3d6f9f;
    border-bottom: none;
    color: #ffffff;
    font-weight: bold;
    margin-bottom: -2px;
}

QGroupBox {
    background-color: #232528;
    border: 1px solid #45484d;
    border-radius: 4px;
    margin-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #d4d4d4;
    margin-top: 0px;
}

QGroupBox > QWidget {
    margin-top: 6px;
}

QGroupBox QLabel {
    background-color: #232528;
    color: #d4d4d4;
}

QLabel#infoLabel {
    background-color: #232528;
    color: #d4d4d4;
}

QFrame#customerFrame,
QFrame#notesFrame {
    background-color: #232528;
    border: 1px solid #45484d;
    border-radius: 4px;
}

QProgressBar {
    background-color: #232528;
    border: 1px solid #45484d;
    border-radius: 4px;
    color: #d4d4d4;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #4b8cc9;
    border-radius: 3px;
}

QDialog,
QMessageBox {
    background-color: #2b2d30;
    border: none;
    border-radius: 6px;
}

QDialog QLabel,
QMessageBox QLabel {
    background-color: #2b2d30;
    color: #d4d4d4;
}

QDialog#notificationDialog {
    background-color: #2b2d30;
    border: 1px solid #4b8cc9;
    border-radius: 6px;
}

QDialog#progressDialog {
    background-color: #2b2d30;
    border: 1px solid #4b8cc9;
    border-radius: 6px;
}

QDialog#notificationDialog QLabel {
    background-color: #2b2d30;
    color: #d4d4d4;
    border: none;
}

QDialog#progressDialog QProgressBar {
    background-color: #232528;
    border: 1px solid #45484d;
    border-radius: 4px;
    color: #d4d4d4;
    text-align: center;
}

QDialog#progressDialog QProgressBar::chunk {
    background-color: #4b8cc9;
    border-radius: 3px;
}

QStatusBar {
    background-color: #2b2d30;
    color: #bfc1c4;
    border: none;
    border-top: 1px solid #45484d;
}

QStatusBar::item {
    background-color: transparent;
    border: none;
}

QStatusBar QLabel {
    background-color: transparent;
    color: #bfc1c4;
    border: none;
    padding: 0 6px;
}

QMenu {
    background-color: #232528;
    border: 1px solid #45484d;
    border-radius: 4px;
    color: #d4d4d4;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 12px;
}

QMenu::item:selected {
    background-color: #3d6f9f;
    color: #ffffff;
}

QMenu::item:pressed {
    background-color: #315a82;
    color: #ffffff;
}

QToolTip {
    background-color: #232528;
    color: #d4d4d4;
    border: 1px solid #45484d;
    border-radius: 3px;
    padding: 4px 6px;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #2b2d30;
    border: none;
    border-radius: 3px;
}

QScrollBar:vertical {
    width: 10px;
}

QScrollBar:horizontal {
    height: 10px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #45484d;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #5a5e64;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}

QPushButton#transactionsButton,
QPushButton#inventoryButton,
QPushButton#exportButton,
QPushButton#customersButton,
QPushButton#catalogButton,
QPushButton#settingsButton {
    min-width: 90px;
}

QPushButton#saveButton,
QPushButton#restoreButton,
QPushButton#addCategoryButton,
QPushButton#addCustomerButton,
QPushButton#inTransactionButton,
QPushButton#outTransactionButton,
QPushButton#exportButton {
    min-width: 100px;
}

QPushButton#permanentCopyButton,
QPushButton#permanentDeleteButton,
QPushButton#localCopyButton,
QPushButton#localDeleteButton {
    min-width: 0;
    padding: 0;
    background-color: transparent;
    border: 1px solid #45484d;
    border-radius: 3px;
}

QPushButton#notesButton,
QPushButton#cashBalanceButton {
    min-width: 0;
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 3px;
}

QPushButton#permanentCopyButton:hover,
QPushButton#permanentDeleteButton:hover,
QPushButton#localCopyButton:hover,
QPushButton#localDeleteButton:hover {
    background-color: #3a3d41;
    border-color: #5a5e64;
}

QPushButton#permanentCopyButton:pressed,
QPushButton#permanentDeleteButton:pressed,
QPushButton#localCopyButton:pressed,
QPushButton#localDeleteButton:pressed {
    background-color: #303236;
    border-color: #4b8cc9;
}

QPushButton#notesButton:hover,
QPushButton#cashBalanceButton:hover,
QPushButton#transactionsButton:hover,
QPushButton#inventoryButton:hover,
QPushButton#exportButton:hover,
QPushButton#customersButton:hover,
QPushButton#catalogButton:hover,
QPushButton#settingsButton:hover {
    background-color: #45484d;
    border-color: #4386bd;
}

QPushButton#notesButton:pressed,
QPushButton#cashBalanceButton:pressed,
QPushButton#transactionsButton:pressed,
QPushButton#inventoryButton:pressed,
QPushButton#exportButton:pressed,
QPushButton#customersButton:pressed,
QPushButton#catalogButton:pressed,
QPushButton#settingsButton:pressed {
    background-color: #303236;
    border-color: #4b8cc9;
}

QPushButton#notesButton:checked,
QPushButton#cashBalanceButton:checked,
QPushButton#transactionsButton:checked,
QPushButton#inventoryButton:checked,
QPushButton#exportButton:checked,
QPushButton#customersButton:checked,
QPushButton#catalogButton:checked,
QPushButton#settingsButton:checked {
    background-color: #3d6f9f;
    border: 1px solid #4b8cc9;
    color: #ffffff;
}

QPushButton#notesButton:checked:hover,
QPushButton#cashBalanceButton:checked:hover,
QPushButton#transactionsButton:checked:hover,
QPushButton#inventoryButton:checked:hover,
QPushButton#exportButton:checked:hover,
QPushButton#customersButton:checked:hover,
QPushButton#catalogButton:checked:hover,
QPushButton#settingsButton:checked:hover {
    background-color: #4b8cc9;
    border-color: #5a9bd5;
}

QWidget#buttonsContainer {
    background-color: #232528;
}

QGroupBox#sidePanelGroupBox {
    background-color: #232528;
    border: none;
    margin-top: 0px;
    padding: 0px;
}

QGroupBox#settingsSidePanelGroupBox {
    background-color: #232528;
    border: none;
    margin-top: 0px;
}

QWidget#cashTab QLabel,
QWidget#valuesTab QLabel {
    background-color: #2b2d30;
}

QLabel#countLabel,
QLabel#itemsCountLabel,
QLabel#priceCountLabel {
    background-color: #2b2d30;
    color: #d4d4d4;
    font-weight: bold;
}

QLabel#titleLabel,
QLabel#subtitleLabel {
    background-color: #2b2d30;
    color: #d4d4d4;
}

QLabel#branchNameLabel,
QLabel#pathLabel,
QLabel#fileNameLabel {
    background-color: #232528;
    color: #d4d4d4;
}

QLabel#totalLabel,
QLabel#totalLabelValue {
    background-color: #232528;
    font-size: 20px;
    font-weight: bold;
}

QLabel#unitLabel,
QLabel#unitValue,
QLabel#defaultPriceLabel,
QLabel#defaultPriceValue,
QLabel#activeLabel,
QLabel#notesLabel,
QLabel#countLabel,
QLabel#itemsCountLabel,
QLabel#priceCountLabel,
QLabel#priceCountValue,
QLabel#totalCountLabel,
QLabel#totalCountValueLabel,
QLabel#totalPriceLabel,
QLabel#totalPriceValueLabel,
QLabel#othersLabel,
QLabel#customerNameLabel,
QLabel#customerName,
QLabel#documentNumberLabel,
QLabel#documentNumber,
QLabel#addressLabel,
QLabel#address,
QCheckBox#activeValue,
QCheckBox#activeCheckbox,
QLabel#settingsInfoLabel {
    background-color: transparent;
}

QLabel#othersLabel,
QLabel#cashTotalLabel {
    background-color: #232528;
}

QAbstractItemView#customerCompleterPopup::item:hover {
    background-color: #4a4d52;
    color: #ffffff;
}

QDialog#customerDialog QCheckBox {
    background-color: #2b2d30;
}